# ==============================================================================
# NST SoilSight Backend - Environment Variables
# Copy this file to .env in your root directory and adjust values as needed.
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Allowed CORS Origin for the Frontend (Vite runs on http://localhost:5173 by default)
CORS_ORIGIN=http://localhost:5173

# Future Gemini API Integration (Phase 3 - Leave commented out for now)
# GEMINI_API_KEY=your_gemini_api_key_here
